# Copy to .env and edit. Every setting is optional -- perfect-choice runs with
# none of these set, using the defaults shown.

# Where decisions are stored.
# Default: ~/.perfect-choice/decisions.db
#PERFECT_CHOICE_DB_PATH=/path/to/decisions.db

# --- Optional local LLM (criteria suggestions, bias detection, summaries) ---
# Any OpenAI-compatible endpoint; llama-server, LM Studio, Ollama, etc.
# Without one, perfect-choice runs in math-only mode -- every core feature works.
#PERFECT_CHOICE_LLM_URL=http://localhost:8080

# Model name to request. Empty lets the server pick its loaded default.
#PERFECT_CHOICE_LLM_MODEL=

# Seconds to wait for the LLM. Raise it if your model does extended reasoning.
#PERFECT_CHOICE_LLM_TIMEOUT=300

# Set to 1/true/yes to skip the LLM entirely, even if one is reachable.
#PERFECT_CHOICE_NO_LLM=1

# --- Optional memory webhook ---
# Off unless set. When set, every completed decision is POSTed here as JSON
# so an external notes or memory service can keep your decision history.
# Leave it unset unless you have somewhere to send them.
#PERFECT_CHOICE_BRAIN_URL=http://localhost:9000/remember
